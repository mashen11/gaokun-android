#!/sbin/openrc-run
# gaokun3 只有 WiFi，所以"上网"这件事必须开机自己完成，否则救援系统
# 就是一台连不上的机器。
#
# 凭据来源，按优先级：
#   1. /media/gk3/gaokun3/wpa_supplicant.conf   ← 启动介质上（推荐）
#   2. /etc/wpa_supplicant/wpa_supplicant.conf  ← 构建时注入
#
# ★ 优先用介质上那份，是为了让【镜像本身不含任何凭据】：
#   公开发布的 LiveCD 不能带别人家的 WiFi 密码，而救援镜像也不该把密码
#   焊死在只读的 squashfs 里（换了 WiFi 就得重造镜像）。

description="gaokun3 WiFi (wpa_supplicant + dhcpcd)"
# 必须把 pidfile 声明给 OpenRC，否则 rc-status 会把一个【正在好好工作的】
# 服务显示成 crashed —— 实测：WiFi 明明连着、IP 也拿到了，rc-status 却报
# [crashed]。救援系统里一个会说谎的 status 比没有更糟。
pidfile="/run/wpa_supplicant.pid"
IFACE=wlan0
MEDIA_CONF=/media/gk3/gaokun3/wpa_supplicant.conf
IMAGE_CONF=/etc/wpa_supplicant/wpa_supplicant.conf

depend() {
    # ⚠️★ 这里【不能】用 `need localmount`。`need` 是硬依赖 —— 目标服务只要
    #   不在 runlevel 里，本服务就直接不启动，而且不会有明显报错。
    #   本镜像的根是只读 squashfs + tmpfs overlay，**没有任何东西要挂**，
    #   这条依赖从头到尾就是多余的。
    #   2026-08-23 上机：gk3-wifi 与 gk3-sshd 共用这条依赖，于是一起哑掉，
    #   症状是"救援系统起来了但既没网也没 ssh"，完全无从远程排查。
    after localmount
    before sshd
}

start() {
    # lo 自己拉起来：不依赖 ifupdown-ng 的 networking 服务在哪个子包里
    ip link set lo up 2>/dev/null

    # ★ 兜底：如果 ath11k 因为任何原因 probe 失败（固件时序是当前最强假说，
    #   但尚未证实 —— 见 build-rootfs.sh 里那段），这里【重新绑定一次】：
    #   此刻 squashfs 已挂好，/lib/firmware 里的固件一定拿得到。
    #   ⚠️ 这是安全网。它成功与否本身就是证据：
    #      重绑之后 wlan0 出现 ⇒ 确实是"probe 时固件不可达"。
    if [ ! -e "/sys/class/net/$IFACE" ]; then
        ewarn "没有 $IFACE —— 试着重新绑定 ath11k_pci"
        DRV=/sys/bus/pci/drivers/ath11k_pci
        if [ -d "$DRV" ]; then
            for dev in $(ls /sys/bus/pci/devices/); do
                if [ "$(cat /sys/bus/pci/devices/$dev/vendor 2>/dev/null)" = "0x17cb" ]; then
                    echo "$dev" > "$DRV/unbind" 2>/dev/null
                    echo "$dev" > "$DRV/bind"   2>/dev/null
                    einfo "  重绑 $dev"
                fi
            done
            # 给 probe 一点时间
            i=0; while [ ! -e "/sys/class/net/$IFACE" ] && [ $i -lt 15 ]; do sleep 1; i=$((i+1)); done
        else
            ewarn "  连 $DRV 都没有 —— 驱动没编进内核？"
        fi
    fi

    if [ ! -e "/sys/class/net/$IFACE" ]; then
        eerror "还是没有 ${IFACE}。看 /media/gk3/gaokun3/diag/ 里 gk3-diag 写的日志"
        return 1
    fi
    CONF=
    [ -f "$MEDIA_CONF" ] && CONF=$MEDIA_CONF
    [ -z "$CONF" ] && [ -f "$IMAGE_CONF" ] && CONF=$IMAGE_CONF
    if [ -z "$CONF" ]; then
        ewarn "找不到 wpa_supplicant.conf —— WiFi 不启动"
        ewarn "  放一份到 $MEDIA_CONF 再重启即可"
        return 0
    fi
    ebegin "启动 WiFi（配置来自 ${CONF}）"
    ip link set "$IFACE" up
    # 让 wpa_supplicant 自己 daemonize(-B) 并自己写 pidfile(-P)：
    # 比 start-stop-daemon 的 --background --make-pidfile 可靠 ——
    # 后者记的是它 fork 出来那个壳的 pid，不一定是最终的守护进程。
    /sbin/wpa_supplicant -B -i "$IFACE" -c "$CONF" -P "$pidfile"
    # dhcpcd 自己会等载波，不用我们轮询
    start-stop-daemon --start --background --exec /sbin/dhcpcd -- -b "$IFACE"
    eend 0
}

stop() {
    ebegin "停 WiFi"
    start-stop-daemon --stop --quiet --pidfile "$pidfile" 2>/dev/null
    /sbin/dhcpcd -k "$IFACE" 2>/dev/null
    eend 0
}
