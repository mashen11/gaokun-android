#!/bin/sh
# LiveCD 的 tty1 会话：跑图形安装器，退出了就回落到 shell。
#
# ★ 为什么不做成 OpenRC 服务：这个程序要【拥有】一个 VT（切图形模式、
#   拿 DRM master）。放在 inittab 的 tty1 上最直接 —— 它就是那个 VT 的主人。
#   做成服务的话 getty 还占着 tty1，两边抢控制台。
#
# ⚠️ 退出后一定要给一个 shell：安装器崩了而用户面对一块黑屏，
#   等于把人锁在外面。

LOG=/var/log/gk3-installer.log
# 日志优先写回启动介质 —— 这台机器可能既没网也没串口，
# 介质上那份是唯一能事后读到的东西（和 gk3-diag 同一个道理）。
if mount -o remount,rw /media/gk3 2>/dev/null; then
    mkdir -p /media/gk3/gaokun3/diag 2>/dev/null
    LOG=/media/gk3/gaokun3/diag/installer.log
fi

/usr/bin/gk3-installer >"$LOG" 2>&1
RC=$?
sync
mount -o remount,ro /media/gk3 2>/dev/null

echo
echo "安装器退出（退出码 ${RC}）。日志：$LOG"
echo "下面是 shell。要再试一次就敲 gk3-installer。"
echo
exec /bin/sh -l
