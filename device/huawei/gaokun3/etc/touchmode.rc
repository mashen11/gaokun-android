# 触摸手感模式。改一个属性就行：
#   setprop persist.sys.gaokun3.touch_mode game    # 更跟手（默认）
#   setprop persist.sys.gaokun3.touch_mode daily   # 驱动默认，更稳
#
# ★ 用 persist.sys.* 与键盘开关同理：属性上下文是 system_prop，系统应用
#   （Settings，uid system）能直接 SystemProperties.set()，不必再造一个服务。
#
# ⚠️ 默认给 game（device.mk 里设）—— 这台机器的目标就是跑手游，而 game 预设
#    只是关掉平滑与按下防抖、打开跳点检测，属于"更跟手"，不改任何信号处理门限，
#    不会引入幽灵触点。手感不合可随时切 daily。

service gaokun3_touch_game /vendor/bin/gaokun3-touch-mode.sh game
    user root
    group root
    oneshot
    disabled

service gaokun3_touch_daily /vendor/bin/gaokun3-touch-mode.sh daily
    user root
    group root
    oneshot
    disabled

on property:persist.sys.gaokun3.touch_mode=game
    start gaokun3_touch_game

on property:persist.sys.gaokun3.touch_mode=daily
    start gaokun3_touch_daily

# 开机补一次：属性触发器在 init 早期不会重放，而触摸驱动 probe 也要时间。
on boot && property:persist.sys.gaokun3.touch_mode=game
    start gaokun3_touch_game

on boot && property:persist.sys.gaokun3.touch_mode=daily
    start gaokun3_touch_daily
