+/*
+ * 闪光灯（patches/0036，试验）：Windows 的 \_SB.FLSH 设备没有 GPIO/I2C 资源，驱动包只有
+ * 一条 IR LED 电流注册表项 ⇒ 走 PMIC 闪光模块（pmc8280c = PM8350C，主线 leds-qcom-flash）。
+ * GPIO93 直驱实测不亮（#106）。LED 接在哪一路【未知】：先把 4 路各建一个 LED，只给 torch 级
+ * 低电流，上机逐路点亮找出真正接线的那一路，再收成一个节点。
+ */
+&pmc8280c {
+	pmc8280c_flash: led-controller@ee00 {
+		compatible = "qcom,pm8350c-flash-led", "qcom,spmi-flash-led";
+		reg = <0xee00>;
+
+		led-0 {
+			function = LED_FUNCTION_FLASH;
+			color = <LED_COLOR_ID_WHITE>;
+			function-enumerator = <1>;
+			led-sources = <1>;
+			led-max-microamp = <100000>;
+			flash-max-microamp = <300000>;
+			flash-max-timeout-us = <300000>;
+		};
+
+		led-1 {
+			function = LED_FUNCTION_FLASH;
+			color = <LED_COLOR_ID_WHITE>;
+			function-enumerator = <2>;
+			led-sources = <2>;
+			led-max-microamp = <100000>;
+			flash-max-microamp = <300000>;
+			flash-max-timeout-us = <300000>;
+		};
+
+		led-2 {
+			function = LED_FUNCTION_FLASH;
+			color = <LED_COLOR_ID_WHITE>;
+			function-enumerator = <3>;
+			led-sources = <3>;
+			led-max-microamp = <100000>;
+			flash-max-microamp = <300000>;
+			flash-max-timeout-us = <300000>;
+		};
+
+		led-3 {
+			function = LED_FUNCTION_FLASH;
+			color = <LED_COLOR_ID_WHITE>;
+			function-enumerator = <4>;
+			led-sources = <4>;
+			led-max-microamp = <100000>;
+			flash-max-microamp = <300000>;
+			flash-max-timeout-us = <300000>;
+		};
+	};
+};
+
