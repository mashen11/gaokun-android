--- a/drivers/input/touchscreen/hx-algo.c
+++ b/drivers/input/touchscreen/hx-algo.c
@@ -81,7 +81,134 @@ void hx_algo_init_defaults(struct hx_algo *algo)
 	algo->pen_confirm_frames = 3;
 	algo->pen_lost_frames    = 10;
 	/*
-	 * Sub-cell centroid, 2 cells (5x5 window).
+	 * Latch gate (0053).
+	 *
+	 * The path used to latch on three consecutive candidates, and that is why
+	 * roughly one stray mark every ten seconds appeared on the panel.  Of the
+	 * 10016 captured pen frames below, 116 candidate streaks were not strokes
+	 * at all: their median in-streak travel is 0.0 cells, they sit on a fixed
+	 * cell and recur there for the whole session (e.g. cell (1,58) at frame
+	 * 687 and again at 45708) -- a stationary per-node offset in raw_frame,
+	 * which the finger path never sees because CMF and the IIR remove it but
+	 * this path reads the grid before either runs.
+	 *
+	 * Measured on that capture (116 ghost streaks vs 42 real strokes):
+	 *
+	 *	rule			ghosts kept	real strokes lost	latency
+	 *	confirm>=3 (old)	70/92		0/42			3 fr = 25 ms
+	 *	travel >= 1 cell	27/92		0/42			13 fr = 108 ms
+	 *	travel >= 2 cells	 5/92		0/42			25 fr = 208 ms
+	 *
+	 * So a pen is believed when it *moves* 2 cells (8.5 mm), and a stationary
+	 * touch is believed only after 30 frames (0.25 s) -- a dot still works,
+	 * a drift never becomes one, because a drift does not move.
+	 *
+	 * The delay is paid in appearance, not in geometry: on the latch frame the
+	 * position emitted is the streak's *first* candidate, so the stroke still
+	 * begins exactly where the pen landed (see pen->replay_start below).
+	 */
+	algo->pen_latch_travel   = 512;   /* 2 cells */
+	algo->pen_hold_frames    = 30;    /* 0.25 s   */
+	/*
+	 * A latched pen cannot teleport: it is one object in contact with the
+	 * panel, so its position can only change as fast as a hand moves.  The
+	 * capture had 34 frames whose step exceeded 3 cells and 25 exceeding
+	 * 6 cells, up to 11290 units = 188 mm in 8 ms -- all of them the argmax
+	 * briefly landing on another offset elsewhere in the grid.  6 cells =
+	 * 25.6 mm/frame = 3 m/s at 120 Hz, ten times the p99 step of a real
+	 * stroke (1.4 cells), so those frames hold the previous position.
+	 */
+	algo->pen_max_step       = 1536;  /* 6 cells */
+	/*
+	 * A *tap* is a stationary touch, so it used to have to survive
+	 * pen_hold_frames (30 frames = 250 ms) before the path would believe it.
+	 * That is exactly the "click needs a short hold" complaint.
+	 *
+	 * The amplitudes separate, and this is the first place in this driver
+	 * where the two populations can be told apart on something other than
+	 * time.  Measured over the 2026-09-30 capture (111 stationary offsets vs
+	 * 47 real strokes), value at the latch decision (frame 3):
+	 *
+	 *	stationary offset	 p10 158  p50 196  p75 236  p90 340
+	 *	real stroke peak	 p0  249  p10 311  p25 355  p50 461
+	 *
+	 * So a stationary touch whose peak reaches 300 is a contact, not a drift:
+	 * it latches at pen_confirm_frames (~25 ms) instead of after 250 ms.
+	 * Cost, stated honestly: 15 of those 111 offsets (14%) also reach 300 and
+	 * come back -- they are the strong ones (a rejected palm or hand, 400..
+	 * 2900 in amplitude), i.e. the P5 case, not the weak-drift case the gate
+	 * was built for.  Raise this to 400 to cut that to 8%, or set 0 to go
+	 * back to hold-only.  It is a sysfs knob precisely because this is a
+	 * judgement about the user's own hand, not something to settle offline.
+	 *
+	 * 0056 update -- 300 was measured WRONG on this panel.  It sits just
+	 * above the real quick-tap peak, so *every* light tap failed by_amp and
+	 * fell through to the 250 ms hold path (or produced nothing at all):
+	 * user tapping 10x gave latch_amp +0, ghost_runs +96.  That run's
+	 * refused set splits cleanly:
+	 *
+	 *	stationary offset	best <= 185
+	 *	real quick tap		best 211..294
+	 *
+	 * 198 is the geometric mean of that gap (0% leak, 0% loss), and it is
+	 * paired with pen_min_nbr8 = 367 so the amplitude test no longer has to
+	 * carry the whole discrimination on a drift-prone quantity.
+	 */
+	algo->pen_tap_level      = 198;
+	/*
+	 * Spatial discriminator, off by default because it has never been
+	 * measured -- and the one recording that exists cannot answer it (it
+	 * stores the argmax and its value, not the neighbourhood).  It is here so
+	 * the next capture *can*: npix/nbr8 are recorded per frame, and the
+	 * question "does a real tap lift more than one node while a stationary
+	 * offset lifts exactly one?" is decided by those two columns.
+	 */
+	algo->pen_min_pixels     = 0;
+	/*
+	 * 0055/0056: neighbour-lift gate for the **tap** path, 0 = off.
+	 *
+	 * Measured 2026-09-30 (user tapping 10x + resting; the refused set splits
+	 * into two populations on this quantity with a 2.4x gap):
+	 *
+	 *	stationary offset	nbr8 <= 239   best <= 185   npix = 1
+	 *	real tap		nbr8 >= 565   best 211..294
+	 *
+	 * 367 is the geometric mean of that gap -- 0% offset leak, 0% tap loss.
+	 * Verified: 5 taps all latched at conf=3 (25 ms) with ghost_runs +0.
+	 *
+	 * It applies to the amplitude branch ONLY (see by_amp in hx_pen_scan):
+	 * gating the candidate entry with it also drops stroke frames, which
+	 * resets the streak and breaks the move path.
+	 */
+	algo->pen_min_nbr8       = 367;
+	/*
+	 * Sub-cell centroid, 1 cell (3x3 window).  Changed from 2 by the
+	 * 2026-09-30 same-frame capture, which is the first measurement able to
+	 * rank the four windows: all four arms saw byte-identical input, so the
+	 * hand cancels exactly.
+	 *
+	 * Error against a local quadratic fit of the same trace (the intended
+	 * path, +/-33 ms window), 42 real strokes / 8797 frames:
+	 *
+	 *	win	X median	X p90	Y median	Y p90	2D rms
+	 *	0	0.129		1.588	0.000		0.935	2.080
+	 *	1	0.209		0.747	0.159		0.505	1.928
+	 *	2	0.293		0.876	0.241		0.704	1.951
+	 *	3	0.370		1.073	0.282		0.895	1.996
+	 *
+	 * win=0 (pure argmax) is *quiet* -- it holds one cell and therefore has a
+	 * zero median -- but its p90 is twice win=1's: the visible error is the
+	 * rare half-cell snap, and that is what the centroid removes.  The window
+	 * must not grow: 3 x 3 is the sweet spot, wider integrates more of the
+	 * noise than it recovers sub-cell phase.  Direct check of that phase:
+	 * regressing (x_win - x_argmax) on the true offset inside the cell gives
+	 * +141 units/cell for win=1 against an ideal +256, with corr 0.65 --
+	 * i.e. the centroid really does recover about half the quantisation, and
+	 * win=2/3 recover no more (corr 0.53/0.42).
+	 *
+	 * The earlier "no difference between the windows" reading came from a
+	 * metric that detrended each whole stroke, which is blind to exactly this
+	 * (the residual was dominated by hand curvature, not by the estimator).
 	 *
 	 * Why: the argmax estimate is quantised to whichever cell it sits in, so it
 	 * carries a *bias* of up to half a cell -- 42.67/2 output units = 2.13 mm --
@@ -105,7 +232,7 @@ void hx_algo_init_defaults(struct hx_algo *algo)
 	 * (within one cell of the argmax), which is also why a broad low bump
 	 * elsewhere on the panel cannot move the reported tip.
 	 */
-	algo->pen_centroid_win   = 2;
+	algo->pen_centroid_win   = 1;
 }
 
