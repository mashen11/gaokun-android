+#include <linux/bitfield.h>
 #include <linux/bitops.h>
 #include <linux/delay.h>
 #include <linux/err.h>
@@ -137,6 +138,34 @@ static int gdsc_update_collapse_bit(struct gdsc *sc, bool val)
 	return 0;
 }
 
+/*
+ * 诊断（本仓 patches/0023，不上游）：把 GDSCR 与 CFG_GDSCR 原样打出来。
+ * 走内核自己的 regmap，【不碰 /dev/mem】—— 后者在本机读一次就能让内核静默死亡
+ * （docs/stage4-findings.md #83 第三节，用一次停机换来的规矩）。
+ */
+static void gdsc_dump_regs(struct gdsc *sc, const char *tag)
+{
+	unsigned int gdscr = 0xdeadbeef, cfg = 0xdeadbeef;
+
+	regmap_read(sc->regmap, sc->gdscr, &gdscr);
+	regmap_read(sc->regmap, sc->gdscr + CFG_GDSCR_OFFSET, &cfg);
+
+	pr_err("gdsc-dbg %s %s: GDSCR=0x%08x [PWR_ON=%u COLLAPSE=%u HW_CTRL=%u SW_OVR=%u RETAIN_FF=%u EN_REST=%lu EN_FEW=%lu CLK_DIS=%lu] CFG_GDSCR=0x%08x\n",
+	       sc->pd.name, tag, gdscr,
+	       !!(gdscr & PWR_ON_MASK),
+	       !!(gdscr & SW_COLLAPSE_MASK),
+	       !!(gdscr & HW_CONTROL_MASK),
+	       !!(gdscr & SW_OVERRIDE_MASK),
+	       !!(gdscr & GDSC_RETAIN_FF_ENABLE),
+	       (unsigned long)FIELD_GET(EN_REST_WAIT_MASK, gdscr),
+	       (unsigned long)FIELD_GET(EN_FEW_WAIT_MASK, gdscr),
+	       (unsigned long)FIELD_GET(CLK_DIS_WAIT_MASK, gdscr),
+	       cfg);
+}
+
+/* 只盯 titan* —— 本机 dmesg 被 audit 噪声十几秒就刷没，全打等于没打 */
+#define gdsc_is_watched(sc) (!strncmp((sc)->pd.name, "titan", 5))
+
 static int gdsc_toggle_logic(struct gdsc *sc, enum gdsc_status status,
 		bool wait)
 {
@@ -181,8 +210,16 @@ static int gdsc_toggle_logic(struct gdsc *sc, enum gdsc_status status,
 		udelay(1);
 	}
 
+	if (gdsc_is_watched(sc))
+		gdsc_dump_regs(sc, status == GDSC_ON ? "before-ON" : "before-OFF");
+
 	ret = gdsc_poll_status(sc, status);
-	WARN(ret, "%s status stuck at 'o%s'", sc->pd.name, status ? "ff" : "n");
+	if (ret)
+		pr_err("%s status stuck at 'o%s'\n", sc->pd.name, status ? "ff" : "n");
+	if (ret || gdsc_is_watched(sc))
+		gdsc_dump_regs(sc, ret ? "TIMEOUT" :
+			       (status == GDSC_ON ? "after-ON" : "after-OFF"));
+	WARN_ON(ret);
 
 	if (!ret && status == GDSC_OFF) {
 		ret = icc_set_bw(sc->icc_path, 0, 0);
