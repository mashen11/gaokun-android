+	s16 nbr8_streak;	/* max nbr8 over this streak                 */
+	s16 spatial_thr;	/* threshold applied on this frame; 0 = off  */
 };
 
 static void himax_pen_cap_record(struct himax_ts_data *ts)
@@ -1152,6 +1264,9 @@ static void himax_pen_cap_record(struct himax_ts_data *ts)
 	rec->flags = algo->pen.frame_flags;
 	rec->npix = algo->pen.n_pix;
 	rec->nbr8 = algo->pen.nbr8;
+	rec->best_streak = algo->pen.best_streak;
+	rec->nbr8_streak = algo->pen.nbr8_streak;
+	rec->spatial_thr = algo->pen.spatial_thr;
 	for (w = 0; w < HX_PEN_CAP_WINS; w++) {
 		s32 px, py;
 
@@ -1315,11 +1430,16 @@ HX_ALGO_ATTR_S16_RW(pen_threshold);
 HX_ALGO_ATTR_S16_RW(pen_jump_max);
 HX_ALGO_ATTR_S16_RW(pen_confirm_frames);
 HX_ALGO_ATTR_U16_RW(pen_lost_frames);
+/* 0068: long press -> BTN_RIGHT.  0 = disabled (default). */
+HX_ALGO_ATTR_U16_RW(pen_long_frames);
+HX_ALGO_ATTR_U8_RW(pen_long_travel);
 HX_ALGO_ATTR_U8_RW(pen_centroid_win);
 HX_ALGO_ATTR_S16_RW(pen_latch_travel);
 HX_ALGO_ATTR_S16_RW(pen_tap_level);
 HX_ALGO_ATTR_U8_RW(pen_min_pixels);
 HX_ALGO_ATTR_S16_RW(pen_min_nbr8);
+HX_ALGO_ATTR_BOOL_RW(pen_geom_enable);
+HX_ALGO_ATTR_U8_RW(pen_geom_pow);
 HX_ALGO_ATTR_U16_RW(pen_hold_frames);
 HX_ALGO_ATTR_S32_RW(pen_max_step);
 
@@ -1358,6 +1478,14 @@ static ssize_t stats_show(struct device *dev, struct device_attribute *attr,
 	n += sysfs_emit_at(buf, n, "tracks_guard_kill %u\n", st->tracks_guard_kill);
 	n += sysfs_emit_at(buf, n, "tracks_lost       %u\n", st->tracks_lost);
 	n += sysfs_emit_at(buf, n, "max_contacts      %u\n", st->max_contacts);
+	/*
+	 * 0064 (observation only): slots_born_pen + slots_born_finger ==
+	 * tracks_new.  Read against pen_frame_emit: pen frames climbing while
+	 * slots_born_pen stays 0 means the pen's coordinates are riding on
