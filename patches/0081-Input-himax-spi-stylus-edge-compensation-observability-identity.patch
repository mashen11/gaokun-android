+	// input_set_capability(ts->input_dev, EV_KEY, BTN_TOOL_PEN);
+
+	/*
+	 * 0069: declare the button the long press emits.
+	 *
+	 * 0068 already reports BTN_RIGHT from the long-press timer, but never
+	 * declared the capability -- and this driver has *no* input_set_capability()
+	 * call at all, so evdev advertised no buttons whatsoever
+	 * (`/sys/class/input/event11/device/capabilities/key` was "400 0 0 0 0 0",
+	 * BTN_RIGHT = 0x111 = 0).  A key event whose type is not in the bitmap
+	 * is not delivered to libinput, so the long press produced nothing at
+	 * all: enabling pen_long_frames changed nothing observable.
+	 *
+	 * Declaring BTN_RIGHT is the minimum needed and is inert on its own --
+	 * unlike BTN_TOOL_PEN above, it does not change how libinput classifies
+	 * the device (no touch -> tablet flip), so it cannot rotate anything.
+	 */
+	/*
+	 * ROLLED BACK 2026-10-05 07:45 -- 0069's BTN_RIGHT capability was itself a
+	 * regression: declaring a mouse button made libinput classify the whole
+	 * panel as a pointer as well as a touch device
+	 * (`libinput list-devices`: Capabilities went "touch" -> "pointer touch"),
+	 * and the compositor then drove the cursor through the pointer path.
+	 * Symptom: the cursor could not be moved by either finger or pen, and a
+	 * horizontal swipe scrolled vertically -- i.e. the axes were being
+	 * interpreted through the wrong device model.
+	 *
+	 * A long press needs a button, but declaring one here costs the whole
+	 * input path.  It has to come with a *dedicated* input device for the
+	 * pen instead (see refs-upstream 2.2 / A5), not by adding a button to the
+	 * touch device.
+	 */
+	// input_set_capability(ts->input_dev, EV_KEY, BTN_RIGHT);
+
 	ret = input_register_device(ts->input_dev);
 	if (ret)
 		return ret;
@@ -1113,9 +1216,14 @@ static DEVICE_ATTR_RW(_name)
  * ranking was measuring the hand, not the algorithm (report sections 12.7/12.8).
  * Giving all four arms one stroke removes that term by construction.
  *
- * Record is 24 bytes; the ring holds 16384 -> about two minutes of pen contact
- * at 120 Hz.  There is no enable switch: capture only runs while the pen path
