+/*
+ * 0062: the spatial gate's own geometry.
+ *
+ * nbr8 is the sum of the eight raw values around the argmax, and the loop
+ * that builds it skips the neighbours that fall outside the grid.  A cell
+ * on the border therefore has fewer of them: 5 on an edge, 3 in a corner.
+ * Comparing that sum against a flat 367 asks a corner cell for a lift only
+ * an interior cell could produce, and it shows in the numbers -- on the
+ * 2026-10-02 corpus 78.4% of edge candidates were refused against 24.6%
+ * inside, and two corners latched at 0% while the centre latched at 99.13%.
+ *
+ * So hold the demand *per neighbour* constant instead:
+ *
+ *	thr(cell) = pen_min_nbr8 * (n_in(cell) / 8) ^ pen_geom_pow
+ *
+ * which is 367 inside, 90 on an edge and 19 in a corner at p = 3.  The
+ * interior cannot move, because (8/8)^p is 1 for every p.
+ *
+ * n_in is derived from the same geometry the nbr8 loop uses rather than
+ * from a hand-written table, so the two cannot drift apart.
+ *
+ * Returns pen_min_nbr8 itself when pen_geom_enable is false, and 0 when
+ * the gate is off, so both escape hatches stay exact: 0 means "no gate",
+ * pen_geom_enable = 0 means "the flat scalar gate of 0056/0057".
+ */
+static s16 hx_pen_geom_thr(const struct hx_algo *algo, u8 r, u8 c)
+{
+	s32 ref = algo->pen_min_nbr8;
+	u32 num = 1, den = 1, n, p, i;
+	u32 nr = 3, nc = 3;
+
+	if (ref <= 0)
+		return 0;
+	if (!algo->pen_geom_enable)
+		return (s16)ref;
+
+	/*
+	 * n_in, the count the nbr8 loop ends up summing over: the three rows
+	 * and three columns around the argmax, clipped to the panel, minus the
+	 * argmax itself -- 8 inside, 5 on an edge, 3 in a corner.  It is
+	 * rows * columns - 1 and not 8 minus one per clipped line, because
+	 * clipping one row takes three neighbours away, not one.
+	 */
+	if (r == 0)
+		nr--;
+	if (r == HX_ROWS - 1)
+		nr--;
+	if (c == 0)
+		nc--;
+	if (c == HX_COLS - 1)
+		nc--;
+	n = nr * nc - 1;
+
+	/*
+	 * (n/8)^p in integers.  p is clamped to 3, so the widest product is
+	 * 367 * 8^3 = 187904 -- far inside s32, nothing here can overflow.
+	 */
+	p = algo->pen_geom_pow;
+	if (p > 3)
+		p = 3;
+	for (i = 0; i < p; i++) {
+		num *= n;
+		den *= 8;
+	}
+
+	/* Round to nearest, so an edge lands on 90 rather than 89. */
+	return (s16)(((s32)ref * (s32)num + (s32)den / 2) / (s32)den);
+}
