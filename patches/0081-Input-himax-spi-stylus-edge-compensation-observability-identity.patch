+	 */
+	n += sysfs_emit_at(buf, n, "slots_born_pen    %u\n", st->slots_born_pen);
+	n += sysfs_emit_at(buf, n, "slots_born_finger %u\n", st->slots_born_finger);
 	/*
 	 * Pen path.  pen_frame_cand counts frames where the raw grid had a
 	 * pixel over pen_threshold; pen_frame_emit counts frames the path was
@@ -1378,6 +1506,18 @@ static ssize_t stats_show(struct device *dev, struct device_attribute *attr,
 			   ts->algo->pen.rej_jump);
 	n += sysfs_emit_at(buf, n, "pen_frame_emit    %u\n",
 			   ts->algo->pen.frames_emit);
+	/*
+	 * 0063: and *why* the rest did not.  Read next to pen_frame_cand:
+	 * cand = emit + ghost_runs is the coarse split, these three are
+	 * the fine one, and pen_dec_spatial is the single number that
