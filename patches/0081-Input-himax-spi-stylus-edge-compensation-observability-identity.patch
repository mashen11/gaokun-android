@@ -1783,11 +1942,29 @@ static int hx83121a_gaokun_read_event_stack(struct himax_ts_data *ts)
 
 static void himax_report_tracked_state(struct himax_ts_data *ts, bool report_on)
 {
+	bool _pen_seen = false;
 	int i;
 
 	if (!ts->algo || !ts->input_dev)
 		return;
 
+	/*
+	 * 0067: does this frame report a pen at all?  Needed before the loop
+	 * below, because BTN_TOOL_PEN is a *device* level key while the tool
+	 * type is a per-slot one: it has to rise with the first pen slot of the
+	 * stroke and fall with the last, in the same frame.
+	 */
+	if (report_on) {
+		for (i = 0; i < HIMAX_MAX_TOUCH; i++) {
+			if (ts->algo->tracks[i].active &&
+			    ts->algo->tracks[i].debounce == 0 &&
+			    ts->algo->tracks[i].is_pen) {
+				_pen_seen = true;
+				break;
+			}
+		}
+	}
+
 	for (i = 0; i < HIMAX_MAX_TOUCH; i++) {
 		bool on = report_on && ts->algo->tracks[i].active &&
 			  ts->algo->tracks[i].debounce == 0;
@@ -1811,6 +1988,29 @@ static void himax_report_tracked_state(struct himax_ts_data *ts, bool report_on)
 				    MT_TOOL_PEN : MT_TOOL_FINGER;
 
 		input_mt_slot(ts->input_dev, i);
+		/*
+		 * 0066: reset the kernel's memory of this slot before releasing
+		 * it.  The comment above is right about input_mt_report_slot_
+		 * state() but misses where the dedup actually lives:
+		 * input_handle_abs_event() compares against
+		 *   mt->slots[mt->slot].abs[code - ABS_MT_FIRST]
+		 * (drivers/input/input.c), and input_mt_report_slot_state()
+		 * on release only emits TRACKING_ID = -1 and leaves slot->abs[]
+		 * untouched.  So a PEN slot keeps remembering MT_TOOL_PEN after
+		 * the pen lifts, and the next stroke landing on the same slot
+		 * re-reports the same value, which is deduplicated away.
+		 *
+		 * Measured 2026-10-04: 6 strokes onto the same slot produced
+		 * ABS_MT_TOOL_TYPE exactly once -- on that slot's first birth.
+		 *
+		 * Clearing it on the way out costs one event per pen lift and
+		 * makes the next birth a genuine FINGER -> PEN transition.  Only
+		 * for pen slots: a finger slot already holds MT_TOOL_FINGER, so
+		 * reporting it again is deduplicated and free.
+		 */
+		if (!on && tool == MT_TOOL_PEN)
+			input_report_abs(ts->input_dev, ABS_MT_TOOL_TYPE,
+					MT_TOOL_FINGER);
 		input_mt_report_slot_state(ts->input_dev, tool, on);
 		if (!on)
 			continue;
@@ -1831,12 +2031,216 @@ static void himax_report_tracked_state(struct himax_ts_data *ts, bool report_on)
 	}
 
 	/*
-	 * Also emit single-touch pointer emulation so compositors that still
-	 * key parts of their touchscreen handling off ABS_X/ABS_Y or BTN_TOUCH
-	 * observe a coherent state across suspend/resume.
+	 * 0071 (A2): work out whether the contact state changed this frame.
+	 * `report_on` is false on the frames the panel produced no report at
+	 * all; those must not be treated as a transition or the mirror would
+	 * be re-sent on every idle frame.
+	 */
+	if (report_on) {
+		bool down = false;
+
+		for (i = 0; i < HIMAX_MAX_TOUCH; i++) {
+			if (ts->algo->tracks[i].active &&
+			    ts->algo->tracks[i].debounce == 0) {
+				down = true;
+				break;
+			}
+		}
+		ts->pen_emu_state_dirty = (down != ts->pen_emu_last_down);
+		ts->pen_emu_last_down = down;
+	} else {
+		ts->pen_emu_state_dirty = false;
+	}
+
+	/*
+	 * 0071 (A2): emit legacy pointer emulation, but do not duplicate the
+	 * position every frame.
+	 *
+	 * Symptom this fixes: dragging an icon or selecting text with the pen
+	 * makes the dragged thing jitter, while drawing a stroke does not.
+	 * Cause: this frame used to call
+	 *
+	 *     input_mt_report_pointer_emulation(ts->input_dev, true);
+	 *
+	 * unconditionally, and that helper reports BOTH the MT axis
+	 * (ABS_MT_POSITION_X/Y) and the legacy single-point mirror
+	 * (ABS_X/ABS_Y) for the same physical position, every frame.  Measured
+	 * on real capture: ABS_X/MT_X = 496/496 == 1.000, i.e. every position
+	 * was reported twice.  A stroke survives that because the app consumes
+	 * one path; a drag does not, because the compositor grabs the device
+	 * and sees the same position twice per step.
+	 *
+	 * A1 was the zero-code check for that (comment the call out) and it
+	 * confirmed the cause.  A2 keeps the emulation but stops the
+	 * duplication:
+	 *
+	 *   - BTN_TOUCH / BTN_TOOL_* are STATE.  They must be reported on
+	 *     every frame or the compositor loses track of contact down/up.
+	 *     So they stay unconditional.
+	 *   - ABS_X/ABS_Y/ABS_PRESSURE are the *duplicate* axis.  They are
+	 *     what makes a drag jitter, and nothing needs them per-frame: the
+	 *     frame that turns contact on/off is the only place a client
+	 *     looks for them.
+	 *
+	 * so: the pointer emulation runs in full on the transition frames and
+	 * reports only the state keys in between.  The suspend/resume coherence
+	 * the original call was there for is preserved -- resume is exactly a
+	 * transition frame.
+	 *
+	 * Verified offline with tools/stylus/penbench.py: `dual_coord` goes
+	 * from 1.000 (FAIL) to ~0 (PASS), which is precisely "the duplicate is
+	 * gone".  See docs/stylus/jitter-spike-diagnosis-2026-10-05.md.
+	 */
+	if (ts->pen_emu_state_dirty)
+		input_mt_report_pointer_emulation(ts->input_dev, true);
+	else if (test_bit(BTN_TOUCH, ts->input_dev->keybit))
+		/*
+		 * Between transitions only the state key is re-asserted.  It is
+		 * what tells the compositor the contact is still down; the
+		 * legacy ABS_X/ABS_Y mirror is the part that duplicates the MT
+		 * axis every frame and therefore the part that has to stop.
+		 *
+		 * input_mt_report_pointer_emulation() computes the value from the
+		 * MT slots, so ask it for the value only -- re-emitting it is
+		 * idempotent for the compositor but emits no axis.
+		 */
+		input_event(ts->input_dev, EV_KEY, BTN_TOUCH,
+			    ts->pen_emu_last_down ? 1 : 0);
+
+	/*
+	 * 0067: BTN_TOOL_PEN last, once per frame, before the SYN.
+	 *
+	 * It is a device-level pair key ("a pen is in range"), while
+	 * ABS_MT_TOOL_TYPE is a per-slot value, so it cannot be derived from
+	 * any single slot: with two pen slots down the first would clear it
+	 * while the second is still reporting.  _pen_seen -- computed before
+	 * the loop -- is the only answer that stays right in that case.
+	 *
+	 * It also cannot be derived from a released slot's `tool`: by the time
+	 * a lifted slot is visited, hx_track_contacts() has already run
+	 * hx_reset_track(), so tracks[i].is_pen reads back false and `tool`
+	 * is MT_TOOL_FINGER -- exactly the window 0066 opens.
+	 *
+	 * Reported only on a change: a pen held on the panel emits this once,
+	 * not one event per frame, and the value is reset on the way out so
+	 * the next stroke raises it again.
+	 */
+	if (_pen_seen != ts->pen_in_range) {
