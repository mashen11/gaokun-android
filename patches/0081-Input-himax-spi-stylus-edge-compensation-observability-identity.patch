+	/*
+	 * 0067: last value reported for BTN_TOOL_PEN, so the key is emitted
+	 * only on a transition.  A pen resting on the panel must not produce
+	 * one key event per frame.
+	 */
+	bool pen_in_range;
+	/*
+	 * 0068: long press -> BTN_RIGHT state.  Kept here (not in hx_algo)
+	 * because only this file has an input_dev, and because the release
+	 * has to happen even on frames where the pen path produced nothing.
+	 */
+	u16  pen_long_hold;       /* frames the pen has been held down      */
+	bool pen_long_pressed;    /* BTN_RIGHT currently held by us         */
+	u8   pen_long_r, pen_long_c;  /* where it was when the timer expired */
+
+	/*
+	 * 0071 (A2): true when the contact state changed since the last frame,
+	 * i.e. exactly the frames on which the legacy pointer emulation must run
+	 * in full (so BTN_TOUCH and the ABS_X/ABS_Y mirror agree with the MT
+	 * slots).  In between, only BTN_TOUCH is re-reported.
+	 */
+	bool pen_emu_state_dirty;
+	bool pen_emu_last_down;
 };
 
