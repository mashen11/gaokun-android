diff --git a/drivers/media/platform/qcom/camss/camss.c b/drivers/media/platform/qcom/camss/camss.c
index 2123f63..8792dac 100644
--- a/drivers/media/platform/qcom/camss/camss.c
+++ b/drivers/media/platform/qcom/camss/camss.c
@@ -29,6 +29,15 @@
 
 #include "camss.h"
 
+/*
+ * 诊断（本仓 patches/0030，不上游）：按位跳过流水线里某一块的 s_power/s_stream，
+ * 用来把 #104 的"一次 STREAMON/STREAMOFF 就毒化 titan_top"切分到具体哪一块。
+ * bit0=CSIPHY bit1=CSID bit2=VFE bit3=传感器（media 函数为 CAM_SENSOR 的子设备）。
+ * /sys/module/qcom_camss/parameters/dbg_skip
+ */
+unsigned int camss_dbg_skip;
+module_param_named(dbg_skip, camss_dbg_skip, uint, 0644);
+
 #define CAMSS_CLOCK_MARGIN_NUMERATOR 105
 #define CAMSS_CLOCK_MARGIN_DENOMINATOR 100
 
