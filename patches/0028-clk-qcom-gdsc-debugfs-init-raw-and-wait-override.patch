clk: qcom: gdsc: debugfs 诊断 —— 记下覆盖前的原始 GDSCR，并可运行时改等待值（不上游，依赖 0023）

**用途**：给 `patches/0027` 提供直接依据，并在它不灵时不重编内核就能试别的等待值。

1. **`/sys/kernel/debug/gdsc-dbg/init_raw`**：`gdsc_init()` 在写等待字段**之前**读一次
   GDSCR/CFG_GDSCR 存进表里。相机域 UEFI 不碰 ⇒ 读到的就是**硬件复位值**。
   不能靠 `pr_err`：camcc probe 在开机早期，adb 连上时 dmesg 环早被 audit 噪声刷没了
   （#104 记过：2 秒 126 行）。
2. **`/sys/kernel/debug/gdsc-dbg/wait_override`**（x32）：非零时每次翻转前把 GDSCR[23:12]
   写成旋钮值的对应位，只作用于与 `titan*` 同一个 regmap 的 GDSC（= 整个 camcc）。
   例：`0x0022f000` = rest 2 / few 2 / dis 0xf；`0x00282000` = 回到 MSM8974 默认；写 0 关闭。

字段掩码取自本文件自己的宏：`EN_REST_WAIT_MASK`=23:20、`EN_FEW_WAIT_MASK`=19:16、
`CLK_DIS_WAIT_MASK`=15:12。表最多记 96 个 GDSC（本机 gcc+dispcc+gpucc+camcc+videocc 远不到）。

⚠️ **诊断用，不要进发版内核**。⚠️ diff 由 `git diff` 生成，不是手写 hunk 头。

diff --git a/drivers/clk/qcom/gdsc.c b/drivers/clk/qcom/gdsc.c
index 2c3b1d5..48f4733 100644
--- a/drivers/clk/qcom/gdsc.c
+++ b/drivers/clk/qcom/gdsc.c
@@ -5,6 +5,8 @@
 
 #include <linux/bitfield.h>
 #include <linux/bitops.h>
+#include <linux/debugfs.h>
+#include <linux/seq_file.h>
 #include <linux/delay.h>
 #include <linux/err.h>
 #include <linux/export.h>
@@ -166,11 +168,83 @@ static void gdsc_dump_regs(struct gdsc *sc, const char *tag)
 /* 只盯 titan* —— 本机 dmesg 被 audit 噪声十几秒就刷没，全打等于没打 */
 #define gdsc_is_watched(sc) (!strncmp((sc)->pd.name, "titan", 5))
 
+/*
+ * 诊断（本仓 patches/0028，不上游，依赖 0023）：
+ * ① 记下每个 GDSC 在 gdsc_init() 覆盖【之前】的原始 GDSCR/CFG_GDSCR。相机域 UEFI 不碰，
+ *    所以这就是硬件复位值 —— 判断 patches/0027 那组等待值对不对的唯一直接依据。
+ *    不能靠 pr_err：camcc probe 在开机早期，等 adb 连上时 dmesg 环早被 audit 噪声刷没了，
+ *    所以存进表里，从 debugfs gdsc-dbg/init_raw 读。
+ * ② 旋钮 gdsc-dbg/wait_override：非零时，每次翻转前把 GDSCR[23:12] 三个等待字段写成
+ *    旋钮值的对应位（只作用于与 titan* 同一个 regmap 的 GDSC，即整个 camcc）。
+ *    用途是不重编内核就能试别的等待值组合；写 0 关闭。
+ */
+#define GDSC_DBG_MAX 96
+static struct { const char *name; u32 gdscr, cfg; } gdsc_dbg_init[GDSC_DBG_MAX];
+static int gdsc_dbg_init_n;
+static struct regmap *gdsc_dbg_camcc_regmap;
+static u32 gdsc_dbg_wait_override;
+static struct dentry *gdsc_dbg_dir;
+
+static int gdsc_dbg_init_raw_show(struct seq_file *m, void *unused)
+{
+	int i;
+
+	for (i = 0; i < gdsc_dbg_init_n; i++) {
+		u32 g = gdsc_dbg_init[i].gdscr;
+
+		seq_printf(m, "%-28s GDSCR=0x%08x [PWR_ON=%u RETAIN_FF=%u EN_REST=%lu EN_FEW=%lu CLK_DIS=%lu] CFG_GDSCR=0x%08x\n",
+			   gdsc_dbg_init[i].name, g,
+			   !!(g & PWR_ON_MASK), !!(g & GDSC_RETAIN_FF_ENABLE),
+			   (unsigned long)FIELD_GET(EN_REST_WAIT_MASK, g),
+			   (unsigned long)FIELD_GET(EN_FEW_WAIT_MASK, g),
+			   (unsigned long)FIELD_GET(CLK_DIS_WAIT_MASK, g),
+			   gdsc_dbg_init[i].cfg);
+	}
+	return 0;
+}
+DEFINE_SHOW_ATTRIBUTE(gdsc_dbg_init_raw);
+
+static void gdsc_dbg_record_init(struct gdsc *sc)
+{
+	unsigned int gdscr = 0xdeadbeef, cfg = 0xdeadbeef;
+
+	regmap_read(sc->regmap, sc->gdscr, &gdscr);
+	regmap_read(sc->regmap, sc->gdscr + CFG_GDSCR_OFFSET, &cfg);
+	if (gdsc_dbg_init_n < GDSC_DBG_MAX) {
+		gdsc_dbg_init[gdsc_dbg_init_n].name = sc->pd.name;
+		gdsc_dbg_init[gdsc_dbg_init_n].gdscr = gdscr;
+		gdsc_dbg_init[gdsc_dbg_init_n].cfg = cfg;
+		gdsc_dbg_init_n++;
+	}
+	if (gdsc_is_watched(sc))
+		gdsc_dbg_camcc_regmap = sc->regmap;
+	if (!gdsc_dbg_dir) {
+		gdsc_dbg_dir = debugfs_create_dir("gdsc-dbg", NULL);
+		debugfs_create_file("init_raw", 0444, gdsc_dbg_dir, NULL,
+				    &gdsc_dbg_init_raw_fops);
+		debugfs_create_x32("wait_override", 0644, gdsc_dbg_dir,
+				   &gdsc_dbg_wait_override);
+	}
+}
+
+static void gdsc_dbg_apply_wait_override(struct gdsc *sc)
+{
+	u32 mask = EN_REST_WAIT_MASK | EN_FEW_WAIT_MASK | CLK_DIS_WAIT_MASK;
+
+	if (!gdsc_dbg_wait_override || !gdsc_dbg_camcc_regmap ||
+	    sc->regmap != gdsc_dbg_camcc_regmap)
+		return;
+	regmap_update_bits(sc->regmap, sc->gdscr, mask,
+			   gdsc_dbg_wait_override & mask);
+}
+
 static int gdsc_toggle_logic(struct gdsc *sc, enum gdsc_status status,
 		bool wait)
 {
 	int ret;
 
+	gdsc_dbg_apply_wait_override(sc);
+
 	if (status == GDSC_ON && sc->rsupply) {
 		ret = regulator_enable(sc->rsupply);
 		if (ret < 0)
@@ -480,6 +554,7 @@ static int gdsc_init(struct gdsc *sc)
 		sc->en_few_wait_val << EN_FEW_WAIT_SHIFT |
 		sc->clk_dis_wait_val << CLK_DIS_WAIT_SHIFT;
 
+	gdsc_dbg_record_init(sc);
 	ret = regmap_update_bits(sc->regmap, sc->gdscr, mask, val);
 	if (ret)
 		return ret;
