@@ -179,10 +181,33 @@ static void gdsc_dump_regs(struct gdsc *sc, const char *tag)
  *    用途是不重编内核就能试别的等待值组合；写 0 关闭。
  */
 #define GDSC_DBG_MAX 96
-static struct { const char *name; u32 gdscr, cfg; } gdsc_dbg_init[GDSC_DBG_MAX];
+static struct { const char *name; u32 gdscr, cfg; struct gdsc *sc; } gdsc_dbg_init[GDSC_DBG_MAX];
 static int gdsc_dbg_init_n;
 static struct regmap *gdsc_dbg_camcc_regmap;
 static u32 gdsc_dbg_wait_override;
+/*
+ * 诊断（本仓 patches/0029，不上游，依赖 0023/0028）：
+ * flags_mask       —— 对 camcc 家族【屏蔽】的 struct gdsc 旗标位（目前只实现 RETAIN_FF_ENABLE=BIT(7)）：
+ *                     上电后不置 RETAIN_FF，且塌缩前把 GDSCR bit11 清掉。
+ * pre_off_delay_ms —— camcc 家族每次塌缩前 msleep 这么久（#104 第六节第 2 条）。
+ * raw              —— 写 "on|off|retain0|retain1|dump <gdsc名>"：绕开 genpd 直接翻转一个 GDSC，
+ *                     用来问"只裸开关一次 ife_0，再塌缩 titan_top，会不会毒化"。
+ *                     安全阀：只许 camcc 家族；genpd 认为【开着】的域不许裸关（正在用它的驱动会撞总线）；
+ *                     父域没开时不许裸开子域。
+ */
+static u32 gdsc_dbg_flags_mask;
+static u32 gdsc_dbg_pre_off_delay_ms;
+static const struct file_operations gdsc_dbg_raw_fops;
+
+static bool gdsc_dbg_family(struct gdsc *sc)
+{
+	return gdsc_dbg_camcc_regmap && sc->regmap == gdsc_dbg_camcc_regmap;
+}
+
+static bool gdsc_dbg_masked(struct gdsc *sc, u16 flag)
+{
+	return gdsc_dbg_family(sc) && (gdsc_dbg_flags_mask & flag);
+}
 static struct dentry *gdsc_dbg_dir;
 
 static int gdsc_dbg_init_raw_show(struct seq_file *m, void *unused)
@@ -214,6 +239,7 @@ static void gdsc_dbg_record_init(struct gdsc *sc)
 		gdsc_dbg_init[gdsc_dbg_init_n].name = sc->pd.name;
 		gdsc_dbg_init[gdsc_dbg_init_n].gdscr = gdscr;
 		gdsc_dbg_init[gdsc_dbg_init_n].cfg = cfg;
+		gdsc_dbg_init[gdsc_dbg_init_n].sc = sc;
 		gdsc_dbg_init_n++;
 	}
 	if (gdsc_is_watched(sc))
@@ -224,6 +250,12 @@ static void gdsc_dbg_record_init(struct gdsc *sc)
 				    &gdsc_dbg_init_raw_fops);
 		debugfs_create_x32("wait_override", 0644, gdsc_dbg_dir,
 				   &gdsc_dbg_wait_override);
+		debugfs_create_x32("flags_mask", 0644, gdsc_dbg_dir,
+				   &gdsc_dbg_flags_mask);
+		debugfs_create_u32("pre_off_delay_ms", 0644, gdsc_dbg_dir,
+				   &gdsc_dbg_pre_off_delay_ms);
+		debugfs_create_file("raw", 0200, gdsc_dbg_dir, NULL,
+				    &gdsc_dbg_raw_fops);
 	}
 }
 
@@ -422,7 +454,7 @@ static int gdsc_enable(struct generic_pm_domain *domain)
 	 */
 	udelay(1);
 
-	if (sc->flags & RETAIN_FF_ENABLE)
+	if ((sc->flags & RETAIN_FF_ENABLE) && !gdsc_dbg_masked(sc, RETAIN_FF_ENABLE))
 		gdsc_retain_ff_on(sc);
 
 	/* Turn on HW trigger mode if supported */
@@ -483,6 +515,11 @@ static int gdsc_disable(struct generic_pm_domain *domain)
 	if (sc->pwrsts == PWRSTS_RET_ON)
 		return 0;
 
+	if (gdsc_dbg_masked(sc, RETAIN_FF_ENABLE))
+		regmap_update_bits(sc->regmap, sc->gdscr, GDSC_RETAIN_FF_ENABLE, 0);
+	if (gdsc_dbg_family(sc) && gdsc_dbg_pre_off_delay_ms)
+		msleep(gdsc_dbg_pre_off_delay_ms);
+
 	ret = gdsc_toggle_logic(sc, GDSC_OFF, domain->synced_poweroff);
 	if (ret)
 		return ret;
@@ -493,6 +530,71 @@ static int gdsc_disable(struct generic_pm_domain *domain)
 	return 0;
 }
 
+static struct gdsc *gdsc_dbg_find(const char *name)
+{
+	int i;
+
+	for (i = 0; i < gdsc_dbg_init_n; i++)
+		if (!strcmp(gdsc_dbg_init[i].name, name))
+			return gdsc_dbg_init[i].sc;
+	return NULL;
+}
+
+static ssize_t gdsc_dbg_raw_write(struct file *file, const char __user *ubuf,
+				  size_t count, loff_t *ppos)
+{
+	char buf[64], cmd[16], name[40];
+	struct gdsc *sc;
+	struct device *dev;
+	int ret;
+
+	if (count >= sizeof(buf))
+		return -EINVAL;
+	if (copy_from_user(buf, ubuf, count))
+		return -EFAULT;
+	buf[count] = 0;
+	if (sscanf(buf, "%15s %39s", cmd, name) != 2)
+		return -EINVAL;
+	sc = gdsc_dbg_find(name);
+	if (!sc)
+		return -ENOENT;
+	if (!gdsc_dbg_family(sc))
+		return -EPERM;
+	if (!strcmp(cmd, "off") && sc->pd.status == GENPD_STATE_ON)
+		return -EBUSY;
+	if (!strcmp(cmd, "on") && sc->parent && sc->parent->status != GENPD_STATE_ON)
+		return -EAGAIN;
+
+	dev = regmap_get_device(sc->regmap);
+	ret = pm_runtime_resume_and_get(dev);
+	if (ret < 0)
+		return ret;
+
+	pr_err("gdsc-dbg raw: %s %s\n", cmd, name);
+	if (!strcmp(cmd, "on"))
+		ret = gdsc_enable(&sc->pd);
+	else if (!strcmp(cmd, "off"))
+		ret = gdsc_disable(&sc->pd);
+	else if (!strcmp(cmd, "retain0"))
+		ret = regmap_update_bits(sc->regmap, sc->gdscr, GDSC_RETAIN_FF_ENABLE, 0);
+	else if (!strcmp(cmd, "retain1"))
+		ret = regmap_update_bits(sc->regmap, sc->gdscr, GDSC_RETAIN_FF_ENABLE,
+					 GDSC_RETAIN_FF_ENABLE);
+	else if (strcmp(cmd, "dump"))
+		ret = -EINVAL;
+	gdsc_dump_regs(sc, ret ? "raw-FAILED" : cmd);
+
+	pm_runtime_put(dev);
+	return ret ? ret : count;
+}
+
+static const struct file_operations gdsc_dbg_raw_fops = {
+	.owner = THIS_MODULE,
+	.open = simple_open,
+	.write = gdsc_dbg_raw_write,
+	.llseek = noop_llseek,
+};
+
 static int gdsc_set_hwmode(struct generic_pm_domain *domain, struct device *dev, bool mode)
 {
 	struct gdsc *sc = domain_to_gdsc(domain);
