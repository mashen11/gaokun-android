+struct hx_pen_path {
+	bool has;
+	u8   last_r;
+	u8   last_c;
+	s16  conf;
+	u16  miss;
+	bool active;
+	s32  x;
+	s32  y;
+	s32  z;
+	u32  frames_cand;
+	u32  frames_emit;
+};
