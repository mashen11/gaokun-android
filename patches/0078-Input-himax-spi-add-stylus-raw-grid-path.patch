+/* ======================================================================== */
+/* Phase 3B — pen path: raw grid + trajectory continuity                    */
+/*                                                                           */
+/* The amplitude pipeline in phases 2A..2D keys on how *strong* a bump is.   */
+/* A conductive pen tip on this panel is 2x2 cells at ~490 with a skirt of   */
+/* 40..80; a fingertip is 4x5 cells at ~3800.  Lowering the gates far enough */
+/* to admit the pen lets the resting panel's own noise through as well       */
+/* (measured: 0.59 contacts/frame resting vs 1.22 with the pen written),     */
+/* so amplitude alone cannot separate them at any setting.                   */
+/*                                                                           */
+/* What does separate them is shape in time.  The recorded stroke advanced   */
+/* 1.4 cells per frame (median), max 4.2, for 313 consecutive frames inside  */
+/* a 7x8-cell patch.  Impulse noise moves at random, so it cannot build the  */
+/* streak; a finger is already handled by phases 2A..2D and never has to     */
+/* reach here.                                                               */
+/*                                                                           */
+/* Read from raw_frame rather than frame[]: raw_frame is the grid as it       */
+/* came off the panel with only the baseline subtracted.  frame[] has been    */
+/* through the CMF, the edge boost and the IIR, and the IIR subtracts         */
+/* decay_step/(1 - weight/256) ~= 102 from every pixel below its dynamic      */
+/* gate -- that is what reduces the pen to a single cell and leaves the       */
+/* isolated-spike gate rejecting it.                                          */
+/* ======================================================================== */
+
+void hx_pen_positions(struct hx_algo *algo, int br, int bc, int win,
+		      s32 *px, s32 *py)
+{
+	s64 wc = 0, wr = 0, wt = 0;
+	int r, c;
+
+	if (win > 0) {
+		for (r = br - win; r <= br + win; r++) {
+			for (c = bc - win; c <= bc + win; c++) {
+				s16 v;
+
+				if (r < 0 || r >= HX_ROWS || c < 0 || c >= HX_COLS)
+					continue;
+				v = algo->raw_frame[r][c];
+				if (v <= 0)
+					continue;
+				wc += (s64)c * 128 * v;
+				wr += (s64)r * 128 * v;
+				wt += v;
+			}
+		}
+	}
+
+	if (wt > 0) {
+		*px = clamp_t(s32, (s32)(wc * 2 / wt) + 0x80,
+			      bc * 256, bc * 256 + 255);
+		*py = clamp_t(s32, (s32)(wr * 2 / wt) + 0x80,
+			      br * 256, br * 256 + 255);
+	} else {
+		*px = bc * 256 + 128;
+		*py = br * 256 + 128;
+	}
+}
+
+bool hx_pen_scan(struct hx_algo *algo)
+{
+	struct hx_pen_path *pen = &algo->pen;
+	s16 best = SHRT_MIN;
+	int br = 0, bc = 0;
+	int r, c;
+
+	if (!algo->pen_enabled)
+		return false;
+
+	for (r = 0; r < HX_ROWS; r++) {
+		for (c = 0; c < HX_COLS; c++) {
+			s16 v = algo->raw_frame[r][c];
+
+			if (v > best) {
+				best = v;
+				br = r;
+				bc = c;
+			}
+		}
+	}
+
+	if (best < algo->pen_threshold) {
+		/*
+		 * No candidate.  Tolerate a gap: one dropped frame in the middle
+		 * of a stroke must not cost a re-confirmation.
+		 */
+		if (pen->miss < U16_MAX)
+			pen->miss++;
+		if (pen->miss > algo->pen_lost_frames) {
+			pen->active = false;
+			pen->conf = 0;
+			pen->has = false;
+		}
+		return false;
+	}
+
+	pen->frames_cand++;
+
+	if (!pen->has) {
+		pen->conf = 1;
+	} else if (abs(br - (int)pen->last_r) <= algo->pen_jump_max &&
+		   abs(bc - (int)pen->last_c) <= algo->pen_jump_max) {
+		if (pen->conf < S16_MAX)
+			pen->conf++;
+	} else {
+		/* Jumped: a different object, or noise.  Restart the streak. */
+		pen->conf = 1;
+	}
+
+	pen->last_r = br;
+	pen->last_c = bc;
+	pen->has = true;
+	pen->miss = 0;
+
+	if (pen->conf >= algo->pen_confirm_frames)
+		pen->active = true;
+
+	if (!pen->active)
+		return false;
+
+	/*
+	 * Sub-cell refinement.
+	 *
+	 * Up to here the position is the integer grid cell of the largest pixel,
+	 * which quantises to +/-0.5 cell -- measured on the panel as a median
+	 * deviation of 0.6..1.3 mm on a 20 cm straight line, with occasional
+	 * single-cell excursions of 3..5 mm.  Those excursions are the argmax
+	 * hopping between two nearly equal cells; averaging the neighbourhood
+	 * keeps the answer between them instead of jumping.
+	 *
+	 * Weight is the clamped raw value, same convention as hx_frame_at():
+	 * the pen's skirt is only 40..80 against a peak of ~490, so a
+	 * peak-relative gate would admit the peak alone and interpolate nothing.
+	 * A plain positive weighting lets the (slightly asymmetric) skirt move
+	 * the answer off the cell centre, which is the sub-cell information
+	 * that exists.
+	 *
+	 * The result is clamped to within one cell of the argmax: this is a
+	 * refinement, not a relocation.  Without that guard a broad low bump
+	 * somewhere else on the panel -- a resting hand, charger coupling --
+	 * could drag the centroid away from the pen tip.
+	 *
+	 * The trajectory gate above stays on the argmax on purpose: that is the
+	 * quantity whose continuity was measured, and mixing a smoothed position
+	 * into the gate would change what the thresholds mean.
+	 */
+	hx_pen_positions(algo, br, bc, algo->pen_centroid_win,
+			 &pen->x, &pen->y);
+
+	pen->z = best;
+	pen->frames_emit++;
+	return true;
+}
